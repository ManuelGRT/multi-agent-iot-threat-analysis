# Copia este archivo como .env y sustituye el marcador localmente.
# Nunca confirmes credenciales reales en Git.
MISTRAL_API_KEY=replace_with_your_mistral_api_key
INGEST_LLM_MODEL=mistral-small-2603
# Modelo que consume el servidor MCP threat_intel para contextualizar.
MITIGATOR_LLM_MODEL=mistral-small-2603
MITIGATOR_LLM_TIMEOUT_SECONDS=60
MITIGATOR_LLM_TOTAL_TIMEOUT_SECONDS=105
MISTRAL_CONNECTION_RETRIES=3
# Transporte productivo. Usa inprocess para la demo y tests sin transporte.
MCP_CLIENT_MODE=stdio
# Debe ser mayor que el presupuesto total interno del mitigador.
MCP_STDIO_TIMEOUT_SECONDS=120

# Directorio unico de cache, memoria de casos y trazas (dos ficheros SQLite).
TFM_STATE_DIR=artifacts
# Override opcional del clasificador de 16 tipos; vacio usa el modelo incluido.
TFM_ATTACK_TYPE_MODEL=
