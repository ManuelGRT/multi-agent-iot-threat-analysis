OLLAMA_HOST=http://127.0.0.1:11434

# Copia este archivo como .env y sustituye solo los proveedores que uses.
# Nunca confirmes credenciales reales en Git.
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key
LLM_PROVIDER=mistral
INGEST_LLM_MODEL=mistral-small-2603
# Cache operativa de exitos Mistral (SQLite, ignorada por git).
TFM_STANDARDIZATION_CACHE_DB=artifacts/cache/mistral_standardization_v2.sqlite3
GEMINI_API_KEY=your_gemini_api_key

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tfm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_URL=postgresql://postgres:change_me@127.0.0.1:5432/tfm
