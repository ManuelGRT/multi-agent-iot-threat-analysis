# Copia este archivo como .env y sustituye el marcador localmente.
# Nunca confirmes credenciales reales en Git.
MISTRAL_API_KEY=replace_with_your_mistral_api_key
INGEST_LLM_MODEL=mistral-small-2603
MITIGATOR_LLM_MODEL=mistral-small-2603
MISTRAL_CONNECTION_RETRIES=3

# Cache de estandarizacion y memoria de casos (SQLite).
TFM_STATE_DIR=artifacts
